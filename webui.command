#!/bin/bash
# macOS: двойной клик по этому файлу открывает Терминал и запускает программу.
# Всё остальное (установка uv, Python и зависимостей, запуск сервера) делает webui.sh.
cd "$(dirname "$0")" || exit 1
bash ./webui.sh
status=$?
echo
echo "Программа остановлена. Это окно можно закрыть."
exit $status
